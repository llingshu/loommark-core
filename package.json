{
  "name": "@llingshu/loommark-core",
  "version": "0.1.1",
  "description": "Portable CodeMirror 6 Markdown editing kernel extracted from LoomMark.",
  "license": "MIT",
  "author": "llingshu",
  "homepage": "https://github.com/llingshu/loommark-core#readme",
  "bugs": {
    "url": "https://github.com/llingshu/loommark-core/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/llingshu/loommark-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "node esbuild.mjs",
    "build": "node esbuild.mjs --production",
    "declarations": "tsc --emitDeclarationOnly --outDir dist",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-test-bundle.mjs && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run test",
    "package": "npm run clean && npm run check && npm run build && npm run declarations"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.1"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
